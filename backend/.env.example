# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/otp_manager"

# JWT Secrets — Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_A_RANDOM_32_BYTE_HEX_STRING"
JWT_EXPIRES_IN="4h"
JWT_REFRESH_SECRET="GENERATE_ANOTHER_RANDOM_32_BYTE_HEX_STRING"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_TEMP_SECRET="GENERATE_ANOTHER_RANDOM_32_BYTE_HEX_STRING"

# AES-256-GCM Encryption Key — Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="GENERATE_A_64_CHARACTER_HEX_STRING"

# Server
PORT=3500
NODE_ENV=production
CORS_ORIGIN="http://localhost:5173"

# IP Whitelist
IP_WHITELIST_ENABLED=false

# First Admin (used in seed)
SEED_ADMIN_EMAIL="admin@yourcompany.com"
SEED_ADMIN_PASSWORD="ChangeThis123!"
SEED_ADMIN_NAME="Admin"
